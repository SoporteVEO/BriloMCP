# SQL Server (Brilo legacy database) — use a READ-ONLY SQL login
SQLSERVER_HOST=your-sql-server-host
SQLSERVER_PORT=1433
SQLSERVER_USERNAME=readonly_user
SQLSERVER_PASSWORD=your_password

# Shared secret required to call the HTTP MCP endpoint (Vercel + `npm run dev:http`).
# Generate with:   openssl rand -hex 32
# Clients must send:   Authorization: Bearer <MCP_AUTH_TOKEN>
# Not used by the stdio transport (`npm run dev` / Cursor local).
MCP_AUTH_TOKEN=change-me-to-a-long-random-string
